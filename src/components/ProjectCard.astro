---
import type { Project } from '@/lib/data';

interface Props { project: Project }
const { project } = Astro.props;
---

<a href={`/projects/${project.id}`} class="card flex flex-col p-6 transition-shadow hover:shadow-lg">
  <div class="flex items-center justify-between gap-2">
    <span
      class:list={[
        'rounded-full px-2.5 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wide',
        project.status === 'active' ? 'bg-green-100 text-green-800' : 'bg-slate-200 text-slate-600',
      ]}
    >
      {project.status}
    </span>
    <span class="text-xs text-(--color-slate-400)">{project.years}</span>
  </div>
  <h3 class="mt-3 font-display text-lg font-semibold leading-tight text-(--color-navy-950)">{project.short_title}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-(--color-slate-600)">{project.description}</p>
  <p class="mt-4 text-xs font-semibold text-(--color-blue-600)">{project.sponsor}</p>
</a>
