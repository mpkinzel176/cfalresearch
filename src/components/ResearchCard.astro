---
import type { ResearchArea } from '@/lib/data';

interface Props { area: ResearchArea }
const { area } = Astro.props;
---

<a href={`/research/${area.id}`} class="card group flex flex-col p-6 transition-shadow hover:shadow-lg">
  <h3 class="font-display text-xl font-semibold text-(--color-navy-950)">{area.title}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-(--color-slate-600)">{area.short_description}</p>
  <span class="mt-4 text-sm font-semibold text-(--color-blue-600) group-hover:underline">Explore →</span>
</a>
