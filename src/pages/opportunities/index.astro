---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { RESEARCH_AREAS } from '@/lib/data';
---

<BaseLayout title="Opportunities" description="Openings for undergraduate researchers, M.S. and Ph.D. students, postdoctoral researchers, and collaborators at CFAL.">
  <section class="container-lab py-16 max-w-3xl">
    <p class="font-mono text-xs uppercase tracking-widest text-(--color-blue-600)">Join Us</p>
    <h1 class="mt-2 font-display text-3xl font-semibold sm:text-4xl">Opportunities</h1>
    <p class="mt-4 leading-relaxed text-(--color-slate-600)">
      CFAL welcomes driven undergraduate and graduate researchers, postdoctoral scholars, and collaborators with an interest in fluid mechanics, aerodynamics, computation, and building things that fly, swim, and operate better — on Earth and beyond.
    </p>

    <div class="mt-10 space-y-8">
      <div class="card p-6">
        <h2 class="font-display text-xl font-semibold">Undergraduate Researchers</h2>
        <p class="mt-2 text-sm leading-relaxed text-(--color-slate-600)">
          Undergraduates join CFAL to assist on active projects spanning CFD, hypersonics, rotorcraft, and space applications, typically starting with a focused, well-scoped task alongside a graduate student mentor. Coursework in fluid mechanics, programming (Python, MATLAB, or C++), and a strong GPA are helpful but not required to start a conversation.
        </p>
      </div>
      <div class="card p-6">
        <h2 class="font-display text-xl font-semibold">M.S. and Ph.D. Students</h2>
        <p class="mt-2 text-sm leading-relaxed text-(--color-slate-600)">
          Graduate students work directly on sponsored research projects across the lab's seven research areas (see below). Strong backgrounds in fluid mechanics, numerical methods, and scientific programming are expected. Funding varies by project and is not guaranteed for every position — reach out to discuss current openings and funding status.
        </p>
      </div>
      <div class="card p-6">
        <h2 class="font-display text-xl font-semibold">Postdoctoral Researchers</h2>
        <p class="mt-2 text-sm leading-relaxed text-(--color-slate-600)">
          Postdoctoral positions arise as sponsored projects require additional technical leadership, typically for candidates with a strong CFD, experimental, or data-driven modeling background relevant to CFAL's research areas.
        </p>
      </div>
      <div class="card p-6">
        <h2 class="font-display text-xl font-semibold">Collaborators</h2>
        <p class="mt-2 text-sm leading-relaxed text-(--color-slate-600)">
          CFAL collaborates with other university labs, government laboratories, and industry partners on joint proposals and shared research. Reach out if your group's expertise complements the lab's research areas.
        </p>
      </div>
    </div>

    <div class="mt-10">
      <h2 class="font-display text-xl font-semibold mb-3">Research Areas</h2>
      <div class="flex flex-wrap gap-2">
        {RESEARCH_AREAS.map((a) => (
          <a href={`/research/${a.id}`} class="rounded-full border border-(--color-blue-600) px-3 py-1 text-xs font-semibold text-(--color-blue-600) hover:bg-(--color-blue-600) hover:text-white">
            {a.title}
          </a>
        ))}
      </div>
    </div>

    <div class="mt-10 card p-6">
      <h2 class="font-display text-xl font-semibold">How to Reach Out</h2>
      <p class="mt-2 text-sm leading-relaxed text-(--color-slate-600)">
        Email <a href="mailto:kinzelm@erau.edu" class="font-semibold text-(--color-blue-600) hover:underline">kinzelm@erau.edu</a> with a brief note about your background and which research area interests you. Students should include a CV/resume and unofficial transcript.
      </p>
      <a href="mailto:kinzelm@erau.edu" class="mt-4 inline-block rounded bg-(--color-navy-950) px-5 py-2.5 text-sm font-semibold text-white hover:bg-(--color-blue-600) transition-colors">
        Start a Conversation
      </a>
    </div>
  </section>
</BaseLayout>
