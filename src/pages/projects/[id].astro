---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PersonCard from '@/components/PersonCard.astro';
import PublicationItem from '@/components/PublicationItem.astro';
import {
  PROJECTS, peopleForProject, publicationsForProject, researchAreaById,
} from '@/lib/data';

export function getStaticPaths() {
  return PROJECTS.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const people = peopleForProject(project);
const pubs = publicationsForProject(project);
const areas = project.research_areas.map((id) => researchAreaById(id)).filter(Boolean);
---

<BaseLayout title={project.title} description={project.description}>
  <section class="container-lab py-16">
    <a href="/projects" class="text-sm font-semibold text-(--color-blue-600) hover:underline">← All projects</a>

    <div class="mt-4 flex items-center gap-3">
      <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide', project.status === 'active' ? 'bg-green-100 text-green-800' : 'bg-slate-200 text-slate-600']}>
        {project.status}
      </span>
      <span class="text-sm text-(--color-slate-400)">{project.years}</span>
    </div>

    <h1 class="mt-3 font-display text-3xl font-semibold sm:text-4xl">{project.title}</h1>
    <p class="mt-4 max-w-3xl leading-relaxed text-(--color-slate-600)">{project.description}</p>

    <dl class="mt-8 grid gap-6 sm:grid-cols-3 max-w-3xl">
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-(--color-slate-400)">Sponsor</dt>
        <dd class="mt-1 font-semibold">{project.sponsor}</dd>
      </div>
      {project.amount && (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-(--color-slate-400)">Funding</dt>
          <dd class="mt-1 font-semibold">{project.amount}</dd>
        </div>
      )}
      {project.collaborators.length > 0 && (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-(--color-slate-400)">Collaborators</dt>
          <dd class="mt-1 font-semibold">{project.collaborators.join(', ')}</dd>
        </div>
      )}
    </dl>

    {areas.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-2">
        {areas.map((a) => a && (
          <a href={`/research/${a.id}`} class="rounded-full border border-(--color-blue-600) px-3 py-1 text-xs font-semibold text-(--color-blue-600) hover:bg-(--color-blue-600) hover:text-white">
            {a.title}
          </a>
        ))}
      </div>
    )}

    {people.length > 0 && (
      <div class="mt-12">
        <h2 class="font-display text-xl font-semibold mb-4">Team</h2>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {people.map((p) => <PersonCard person={p} />)}
        </div>
      </div>
    )}

    {pubs.length > 0 && (
      <div class="mt-12">
        <h2 class="font-display text-xl font-semibold mb-4">Related Publications</h2>
        <div class="card divide-y divide-(--color-line) px-5">
          {pubs.map((pub) => <PublicationItem pub={pub} showBibtex={false} />)}
        </div>
      </div>
    )}
  </section>
</BaseLayout>
